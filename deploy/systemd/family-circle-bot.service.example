[Unit]
Description=Family Circle Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=family-circle
Group=family-circle
WorkingDirectory=/opt/family-circle-bot
EnvironmentFile=/etc/family-circle-bot/environment
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/family-circle-bot

[Install]
WantedBy=multi-user.target
