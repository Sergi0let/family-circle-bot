generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TelegramUserStatus {
  PENDING
  ACTIVE
  BLOCKED
  REJECTED
}

enum TelegramUserRole {
  MEMBER
  MODERATOR
  ADMIN
}

model TelegramUser {
  id             String             @id @default(cuid())
  telegramUserId String             @unique @map("telegram_user_id")
  privateChatId  String?            @unique @map("private_chat_id")
  firstName      String?            @map("first_name")
  lastName       String?            @map("last_name")
  username       String?
  status         TelegramUserStatus @default(PENDING)
  role           TelegramUserRole   @default(MEMBER)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  accessRequest AccessRequest? @relation("AccessRequestApplicant")

  @@map("telegram_users")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AccessRequest {
  id              String              @id @default(cuid())
  applicantUserId String              @unique @map("applicant_user_id")
  status          AccessRequestStatus @default(PENDING)
  decidedByUserId String?             @map("decided_by_user_id")
  requestedAt     DateTime            @default(now()) @map("requested_at")
  decidedAt       DateTime?           @map("decided_at")

  applicant TelegramUser @relation("AccessRequestApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)

  @@map("access_requests")
}
