FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . ./
RUN pnpm build && pnpm prune --prod

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV TZ=UTC

RUN apt-get update \
  && apt-get install --yes --no-install-recommends cron \
  && rm --recursive --force /var/lib/apt/lists/*

WORKDIR /app

COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY docker/easypanel/cron-entrypoint.sh /usr/local/bin/cron-entrypoint
COPY docker/easypanel/cron-job-runner.mjs /app/cron-job-runner.mjs
COPY docker/easypanel/crontab /etc/cron.d/family-circle-bot

RUN chmod 0644 /etc/cron.d/family-circle-bot \
  && chmod 0755 /usr/local/bin/cron-entrypoint \
  && touch /var/log/cron.log

ENTRYPOINT ["/usr/local/bin/cron-entrypoint"]
CMD ["cron", "-f"]
